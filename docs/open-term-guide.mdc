### 2. **Update Dev Command Logic**
Replace the complex terminal launching with simple open-term usage:

```typescript
// In src/core/commands/dev.ts
import VTexec from 'open-term';

private async startAOProcessTerminal(config: any, processName: string, options: any): Promise<void> {
  this.logInfo('Opening new terminal for AO process...');
  
  try {
    // Build the aos command
    const args = [processName];
    if (config.luaFiles && config.luaFiles.length > 0) {
      for (const file of config.luaFiles) {
        args.push('--load', file);
      }
    }
    if (!options.noWatch) {
      args.push('--monitor');
    }
    
    const aosCommand = `aos ${args.join(' ')}`;
    const fullCommand = `cd "${process.cwd()}" && ${aosCommand}; exec bash`;
    
    // Use open-term to launch terminal
    VTexec(fullCommand);
    
    this.logSuccess('AO process terminal opened');
    
  } catch (error) {
    this.logError('Failed to open terminal for AO process', error as Error);
    this.logInfo('Falling back to manual mode...');
    this.showManualAOInstructions(config, processName, options);
  }
}
```

### 3. **Add Fallback Manual Instructions**
Keep a simple manual mode for when open-term fails:

```typescript
private showManualAOInstructions(config: any, processName: string, options: any): void {
  this.logInfo('AO Process Manual Mode');
  this.logInfo('Please run the following command in a separate terminal:');
  
  const args = [processName];
  if (config.luaFiles && config.luaFiles.length > 0) {
    for (const file of config.luaFiles) {
      args.push('--load', file);
    }
  }
  if (!options.noWatch) {
    args.push('--monitor');
  }
  
  const aosCommand = `aos ${args.join(' ')}`;
  this.logInfo(`\n  ${aosCommand}\n`);
}
```

### 4. **Update AO Process Logic**
Simplify the AO process handling:

```typescript
private async startAOProcess(processManager: ProcessManager, config: any, options: any): Promise<void> {
  this.logInfo('Starting AO process logic...');
  
  // Check AOS installation
  await processManager.checkAOSInstallation();
  
  // Find and update Lua files
  await this.findAndUpdateLuaFiles(config);
  
  // Get process name
  const processName = options.process || config.processName || 'ao-process';
  
  // Parse AO mode
  const aoMode = options._optionValues?.aoMode || 'background';
  
  switch (aoMode) {
    case 'background':
      await this.startAOProcessBackground(processManager, config, processName, options);
      break;
    case 'terminal':
      await this.startAOProcessTerminal(config, processName, options);
      break;
    case 'manual':
      this.showManualAOInstructions(config, processName, options);
      break;
    default:
      this.logError(`Unknown AO mode: ${aoMode}`);
      this.logInfo('Available modes: background, terminal, manual');
      break;
  }
}
```

